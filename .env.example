# ClientIQ environment variables

# App
APP_NAME=ClientIQ
APP_ENV=development
APP_SECRET_KEY=change-me-locally
APP_DEBUG=true

# TiDB
TIDB_HOST=localhost
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=clientiq
TIDB_SSL=false

# Pinecone
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=clientiq-docs
PINECONE_UPSERT_BATCH_SIZE=25
PINECONE_REQUEST_TIMEOUT=60

# LLM - Groq
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Optional fallback provider config
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/clientiq.log
